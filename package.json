{
  "name": "care-rag-assistant",
  "version": "1.0.0",
  "description": "Local LLM + RAG + MCP: cited Q&A over documents with Ollama, PostgreSQL/pgvector and TypeScript",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "ingest": "tsx src/ingest.ts",
    "ingest:prod": "node dist/ingest.js",
    "mcp": "tsx src/mcp.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "keywords": [
    "rag",
    "llm",
    "ollama",
    "pgvector",
    "mcp",
    "typescript"
  ],
  "author": "muslando",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "hono": "^4.13.17",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
